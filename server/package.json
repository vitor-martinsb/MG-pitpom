{
  "name": "open-golf-multiplayer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "load-test": "tsx src/load-test.ts",
    "build:native": "cmake -S native -B ../out/server-native && cmake --build ../out/server-native --config Release",
    "test:menu-flicker": "npm run build && node test/menu-flicker.mjs",
    "test:menu-alpha": "npm run build && node test/menu-alpha.mjs",
    "test:menu": "npm run build && node test/menu-readiness.mjs",
    "test:browser": "npm run build && node test/browser.mjs",
    "test:profile-input": "npm run build && node test/profile-input.mjs",
    "test:mobile": "npm run build && node test/mobile.mjs",
    "test:social-music": "npm run build && node test/social-music.mjs",
    "test:deployment": "node test/deployment.mjs",
    "test:i18n-browser": "npm run build && node test/i18n-browser.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
