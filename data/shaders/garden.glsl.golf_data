    "fs": {
      "source": "#version 300 es\nprecision highp float;\nprecision highp int;\nuniform vec4 garden_fs_params[2];\nuniform sampler2D brush_texture;\nin vec3 frag_position;\nin vec3 frag_normal;\nin vec3 frag_color;\nin float frag_kind;\nout vec4 g_frag_color;\nvoid main() {\n    float sunlight = 0.80 + 0.22 * dot(normalize(frag_normal), normalize(vec3(-0.5, 0.9, 0.35)));\n    vec3 paint = frag_color * mix(1.0, sunlight, garden_fs_params[1].z);\n    if (frag_kind > 0.75 && frag_kind < 1.25) {\n        vec3 brush = texture(brush_texture, frag_position.xz * 0.18 + frag_position.y * 0.05).rgb;\n        float pigment = dot(brush, vec3(0.3,0.5,0.2));\n        paint *= 0.88 + pigment * 0.30;\n    }\n    paint *= mix(vec3(1.0), vec3(1.045, 1.015, 0.94), garden_fs_params[1].z);\n    float distance_fog = smoothstep(35.0, 125.0, distance(frag_position, garden_fs_params[0].xyz)) * garden_fs_params[1].y;\n    g_frag_color = vec4(mix(paint, vec3(0.72, 0.83, 0.80), distance_fog * 0.72), garden_fs_params[1].x);\n}\n",
      "inputs": [
        {
          "name": "frag_position",
          "location": 0
        },
        {
          "name": "frag_normal",
          "location": 1
