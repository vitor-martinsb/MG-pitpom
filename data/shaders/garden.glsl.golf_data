{
  "glsl330": {
    "vs": {
      "source": "#version 330\nuniform vec4 garden_vs_params[5];\nin vec3 position;\nin vec3 normal;\nin vec4 color;\nout vec3 frag_position;\nout vec3 frag_normal;\nout vec3 frag_color;\nout float frag_kind;\nvoid main() {\n    vec3 p = position;\n    if (color.a > 1.5) {\n        p.x += sin(garden_vs_params[4].x * 0.035 + position.z * 0.06) * 2.5;\n    } else {\n        p.x += sin(garden_vs_params[4].x * 0.9 + p.x * 0.73 + p.z * 0.61) * 0.045 * color.a;\n        p.z += cos(garden_vs_params[4].x * 0.7 + p.x * 0.45) * 0.025 * color.a;\n    }\n    frag_position = p;\n    frag_normal = normal;\n    frag_color = color.rgb;\n    frag_kind = color.a;\n    gl_Position = mat4(garden_vs_params[0],garden_vs_params[1],garden_vs_params[2],garden_vs_params[3]) * vec4(p, 1.0);\n}\n",
      "inputs": [
        {
          "name": "position",
          "location": 0
        },
        {
          "name": "normal",
          "location": 1
        },
        {
          "name": "color",
          "location": 2
        }
      ],
      "uniforms": [
        {
          "name": "garden_vs_params",
          "size": 80,
          "binding": 0,
          "members": [
            {
              "name": "proj_view_mat",
              "offset": 0,
              "size": 64
            },
            {
              "name": "motion",
              "offset": 64,
              "size": 16
            }
          ]
        }
      ]
    },
    "fs": {
      "source": "#version 330\nuniform vec4 garden_fs_params[2];\nuniform sampler2D brush_texture;\nin vec3 frag_position;\nin vec3 frag_normal;\nin vec3 frag_color;\nin float frag_kind;\nout vec4 g_frag_color;\nvoid main() {\n    float sunlight = 0.80 + 0.22 * dot(normalize(frag_normal), normalize(vec3(-0.5, 0.9, 0.35)));\n    vec3 paint = frag_color * mix(1.0, sunlight, garden_fs_params[1].z);\n    if (frag_kind > 0.75 && frag_kind < 1.25) {\n        vec3 brush = texture(brush_texture, frag_position.xz * 0.18 + frag_position.y * 0.05).rgb;\n        float pigment = dot(brush, vec3(0.3,0.5,0.2));\n        paint *= 0.88 + pigment * 0.30;\n    }\n    paint *= mix(vec3(1.0), vec3(1.045, 1.015, 0.94), garden_fs_params[1].z);\n    float distance_fog = smoothstep(35.0, 125.0, distance(frag_position, garden_fs_params[0].xyz)) * garden_fs_params[1].y;\n    g_frag_color = vec4(mix(paint, vec3(0.72, 0.83, 0.80), distance_fog * 0.72), garden_fs_params[1].x);\n}\n",
      "inputs": [
        {
          "name": "frag_position",
          "location": 0
        },
        {
          "name": "frag_normal",
          "location": 1
        },
        {
          "name": "frag_color",
          "location": 2
        },
        {
          "name": "frag_kind",
          "location": 3
        }
      ],
      "uniforms": [
        {
          "name": "garden_fs_params",
          "size": 32,
          "binding": 0,
          "members": [
            {
              "name": "camera_position",
              "offset": 0,
              "size": 16
            },
            {
              "name": "style",
              "offset": 16,
              "size": 16
            }
          ]
        }
      ],
      "textures": [
        {
          "name": "brush_texture",
          "binding": 0
        }
      ]
    }
  },
  "gles300": {
    "vs": {
      "source": "#version 300 es\nprecision highp float;\nprecision highp int;\nuniform vec4 garden_vs_params[5];\nin vec3 position;\nin vec3 normal;\nin vec4 color;\nout vec3 frag_position;\nout vec3 frag_normal;\nout vec3 frag_color;\nout float frag_kind;\nvoid main() {\n    vec3 p = position;\n    if (color.a > 1.5) {\n        p.x += sin(garden_vs_params[4].x * 0.035 + position.z * 0.06) * 2.5;\n    } else {\n        p.x += sin(garden_vs_params[4].x * 0.9 + p.x * 0.73 + p.z * 0.61) * 0.045 * color.a;\n        p.z += cos(garden_vs_params[4].x * 0.7 + p.x * 0.45) * 0.025 * color.a;\n    }\n    frag_position = p;\n    frag_normal = normal;\n    frag_color = color.rgb;\n    frag_kind = color.a;\n    gl_Position = mat4(garden_vs_params[0],garden_vs_params[1],garden_vs_params[2],garden_vs_params[3]) * vec4(p, 1.0);\n}\n",
