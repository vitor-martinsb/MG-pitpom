{
  "glsl330": {
    "vs": {
      "source": "#version 330\nuniform vec4 ball_vs_params[8];\n\nin vec3 position;\nin vec3 normal;\nin vec2 texture_coord;\n\nout vec3 frag_normal;\nout vec2 frag_texture_coord;\n\nvoid main() {\n    gl_Position = mat4(ball_vs_params[0],ball_vs_params[1],ball_vs_params[2],ball_vs_params[3]) * mat4(ball_vs_params[4],ball_vs_params[5],ball_vs_params[6],ball_vs_params[7]) * vec4(position, 1.0);\n    frag_normal = normalize((transpose(inverse(mat4(ball_vs_params[4],ball_vs_params[5],ball_vs_params[6],ball_vs_params[7]))) * vec4(normal, 0.0)).xyz);\n    frag_texture_coord = texture_coord;\n}\n",
      "inputs": [
        {
          "name": "position",
          "location": 0
        },
        {
          "name": "normal",
          "location": 1
        },
        {
          "name": "texture_coord",
          "location": 2
        }
      ],
      "uniforms": [
        {
          "name": "ball_vs_params",
          "size": 128,
          "binding": 0,
          "members": [
            {
              "name": "proj_view_mat",
              "offset": 0,
              "size": 64
            },
            {
              "name": "model_mat",
              "offset": 64,
              "size": 64
            }
          ]
        }
      ]
    },
    "fs": {
      "source": "#version 330\nuniform vec4 ball_fs_params[1];\nuniform sampler2D ball_normal_map;\n\nin vec3 frag_normal;\nin vec2 frag_texture_coord;\n\nout vec4 g_frag_color;\n\nvoid main() {\n    vec3 n = texture(ball_normal_map, vec2(frag_texture_coord.x, 1.0 - frag_texture_coord.y)).xyz;\n    n = 2.0 * n - 1.0;\n    float dimples = 0.90 + 0.10 * abs(dot(normalize(n), normalize(vec3(-2.0, -3.0, -10.0))));\n    float sunlight = max(dot(normalize(frag_normal), normalize(vec3(-0.5, 0.9, 0.35))), 0.0);\n    float rim = pow(1.0 - abs(frag_normal.z), 3.0) * 0.055;\n    vec3 ceramic = ball_fs_params[0].rgb * dimples * (0.60 + 0.40 * sunlight) + vec3(1.0, 0.91, 0.73) * rim;\n    g_frag_color = vec4(ceramic, ball_fs_params[0].a);\n}\n",
      "inputs": [
        {
          "name": "frag_normal",
          "location": 0
        },
        {
          "name": "frag_texture_coord",
          "location": 1
        }
      ],
      "uniforms": [
        {
          "name": "ball_fs_params",
          "size": 16,
          "binding": 0,
          "members": [
            {
              "name": "color",
              "offset": 0,
              "size": 16
            }
          ]
        }
      ],
      "textures": [
        {
          "name": "ball_normal_map",
          "binding": 0
        }
      ]
    }
  },
  "gles300": {
    "vs": {
      "source": "#version 300 es\nprecision highp float;\nprecision highp int;\nuniform vec4 ball_vs_params[8];\n\nin vec3 position;\nin vec3 normal;\nin vec2 texture_coord;\n\nout vec3 frag_normal;\nout vec2 frag_texture_coord;\n\nvoid main() {\n    gl_Position = mat4(ball_vs_params[0],ball_vs_params[1],ball_vs_params[2],ball_vs_params[3]) * mat4(ball_vs_params[4],ball_vs_params[5],ball_vs_params[6],ball_vs_params[7]) * vec4(position, 1.0);\n    frag_normal = normalize((transpose(inverse(mat4(ball_vs_params[4],ball_vs_params[5],ball_vs_params[6],ball_vs_params[7]))) * vec4(normal, 0.0)).xyz);\n    frag_texture_coord = texture_coord;\n}\n",
