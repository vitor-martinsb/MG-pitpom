{
  "glsl330": {
    "vs": {
      "source": "#version 330\nuniform vec4 aim_line_vs_params[4];\n\nin vec3 position;\nin vec2 texture_coord;\n\nout vec2 frag_texture_coord;\n\nvoid main() {\n    frag_texture_coord = texture_coord;\n    gl_Position = mat4(aim_line_vs_params[0],aim_line_vs_params[1],aim_line_vs_params[2],aim_line_vs_params[3]) * vec4(position, 1.0);\n}\n",
      "inputs": [
        {
          "name": "position",
          "location": 0
        },
        {
          "name": "texture_coord",
          "location": 1
        }
      ],
      "uniforms": [
        {
          "name": "aim_line_vs_params",
          "size": 64,
          "binding": 0,
          "members": [
            {
              "name": "mvp_mat",
              "offset": 0,
              "size": 64
            }
          ]
        }
      ]
    },
    "fs": {
      "source": "#version 330\nuniform vec4 aim_line_fs_params[3];\nuniform sampler2D aim_line_image;\n\nin vec2 frag_texture_coord;\n\nout vec4 g_frag_color;\n\nvoid main() {\n    float a = texture(aim_line_image, aim_line_fs_params[1].zw*frag_texture_coord + aim_line_fs_params[1].xy).a;\n    float t = (aim_line_fs_params[2].x + (aim_line_fs_params[2].y - aim_line_fs_params[2].x)*frag_texture_coord.x)/aim_line_fs_params[2].z; \n    float blend = 1.0;\n    if (t > 0.4) {\n        blend = (1.0 - (t - 0.4) / 0.6);\n        a = a * blend * blend;\n    }\n    g_frag_color = vec4(aim_line_fs_params[0].xyz, aim_line_fs_params[0].w*a);\n}\n",
      "inputs": [
        {
          "name": "frag_texture_coord",
          "location": 0
        }
      ],
      "uniforms": [
        {
          "name": "aim_line_fs_params",
          "size": 48,
          "binding": 0,
          "members": [
            {
              "name": "color",
              "offset": 0,
              "size": 16
            },
            {
              "name": "texture_coord_offset",
              "offset": 16,
              "size": 8
            },
            {
              "name": "texture_coord_scale",
              "offset": 24,
              "size": 8
            },
            {
              "name": "length0",
              "offset": 32,
              "size": 4
            },
            {
              "name": "length1",
              "offset": 36,
              "size": 4
            },
            {
              "name": "total_length",
              "offset": 40,
              "size": 4
            }
          ]
        }
      ],
      "textures": [
        {
          "name": "aim_line_image",
          "binding": 0
        }
      ]
    }
  },
