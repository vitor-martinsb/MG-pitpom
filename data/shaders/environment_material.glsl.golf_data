      "source": "#version 300 es\nprecision highp float;\nprecision highp int;\n\nuniform vec4 environment_material_fs_params[4];\n\nuniform sampler2D environment_material_texture;\nuniform sampler2D environment_material_lightmap_texture0;\nuniform sampler2D environment_material_lightmap_texture1;\n\nin vec3 frag_position;\nin vec2 frag_texturecoord;\nin vec3 frag_normal;\nin vec2 frag_lightmap_uv;\n\nout vec4 g_frag_color;\n\nvoid main() {\n    float gi0 = (1.0 - environment_material_fs_params[1].x) * texture(environment_material_lightmap_texture0, frag_lightmap_uv).x;\n    float gi1 = environment_material_fs_params[1].x * texture(environment_material_lightmap_texture1, frag_lightmap_uv).x; \n    float gi = (gi0 + gi1);\n    float dist_to_ball = distance(frag_position.xz, environment_material_fs_params[0].xz);\n    if (dist_to_ball < 0.14 && frag_position.y < environment_material_fs_params[0].y) {\n        float scale = (0.14 - dist_to_ball) / 0.14;   \n        gi -= scale * scale * 0.8;\n    }\n    gi = clamp(gi, 0.0, 1.2);\n    vec3 color = texture(environment_material_texture, environment_material_fs_params[1].y * frag_texturecoord).rgb;\n    // Broad meadow patches break repetition without moving any surface vertices.\n    if (environment_material_fs_params[3].x > 0.5 && environment_material_fs_params[3].x < 1.5) {\n        float meadow_variation = sin(frag_position.x * 0.63 + sin(frag_position.z * 0.42)) * cos(frag_position.z * 0.39);\n        color *= 0.97 + meadow_variation * 0.06;\n    }\n    float sunlight = max(dot(normalize(frag_normal), normalize(vec3(-0.5, 0.9, 0.35))), 0.0);\n    vec3 painted = color * (0.42 + gi * 0.58) * (0.92 + sunlight * 0.10) * vec3(1.045, 1.02, 0.92);\n    float fog = smoothstep(28.0, 100.0, distance(frag_position, environment_material_fs_params[2].xyz));\n    g_frag_color = vec4(mix(painted, vec3(0.72, 0.83, 0.80), fog * 0.72), 1.0);\n}\n",
      "inputs": [
