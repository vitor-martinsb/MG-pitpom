{
  "glsl330": {
    "vs": {
      "source": "#version 330\n\nuniform vec4 environment_material_vs_params[8];\n\nin vec3 position;\nin vec2 texturecoord;\nin vec3 normal;\nin vec2 lightmap_uv;\n\nout vec3 frag_position;\nout vec2 frag_texturecoord;\nout vec3 frag_normal;\nout vec2 frag_lightmap_uv;\n\nvoid main() {\n    frag_position = (mat4(environment_material_vs_params[0],environment_material_vs_params[1],environment_material_vs_params[2],environment_material_vs_params[3]) * vec4(position, 1.0)).xyz;\n    frag_texturecoord = texturecoord;\n    frag_normal = normalize((transpose(inverse(mat4(environment_material_vs_params[0],environment_material_vs_params[1],environment_material_vs_params[2],environment_material_vs_params[3]))) * vec4(normal, 0.0)).xyz);\n    frag_lightmap_uv = lightmap_uv;\n    gl_Position = mat4(environment_material_vs_params[4],environment_material_vs_params[5],environment_material_vs_params[6],environment_material_vs_params[7]) * mat4(environment_material_vs_params[0],environment_material_vs_params[1],environment_material_vs_params[2],environment_material_vs_params[3]) * vec4(position, 1.0);\n}\n",
      "inputs": [
        {
          "name": "position",
          "location": 0
        },
        {
          "name": "texturecoord",
          "location": 1
        },
        {
          "name": "normal",
          "location": 2
        },
        {
          "name": "lightmap_uv",
          "location": 3
        }
      ],
      "uniforms": [
        {
          "name": "environment_material_vs_params",
          "size": 128,
          "binding": 0,
          "members": [
            {
              "name": "model_mat",
              "offset": 0,
              "size": 64
            },
            {
              "name": "proj_view_mat",
              "offset": 64,
              "size": 64
            }
          ]
        }
      ]
    },
    "fs": {
      "source": "#version 330\n\nuniform vec4 environment_material_fs_params[4];\n\nuniform sampler2D environment_material_texture;\nuniform sampler2D environment_material_lightmap_texture0;\nuniform sampler2D environment_material_lightmap_texture1;\n\nin vec3 frag_position;\nin vec2 frag_texturecoord;\nin vec3 frag_normal;\nin vec2 frag_lightmap_uv;\n\nout vec4 g_frag_color;\n\nvoid main() {\n    float gi0 = (1.0 - environment_material_fs_params[1].x) * texture(environment_material_lightmap_texture0, frag_lightmap_uv).x;\n    float gi1 = environment_material_fs_params[1].x * texture(environment_material_lightmap_texture1, frag_lightmap_uv).x; \n    float gi = (gi0 + gi1);\n    float dist_to_ball = distance(frag_position.xz, environment_material_fs_params[0].xz);\n    if (dist_to_ball < 0.14 && frag_position.y < environment_material_fs_params[0].y) {\n        float scale = (0.14 - dist_to_ball) / 0.14;   \n        gi -= scale * scale * 0.8;\n    }\n    gi = clamp(gi, 0.0, 1.2);\n    vec3 color = texture(environment_material_texture, environment_material_fs_params[1].y * frag_texturecoord).rgb;\n    // Broad meadow patches break repetition without moving any surface vertices.\n    if (environment_material_fs_params[3].x > 0.5 && environment_material_fs_params[3].x < 1.5) {\n        float meadow_variation = sin(frag_position.x * 0.63 + sin(frag_position.z * 0.42)) * cos(frag_position.z * 0.39);\n        color *= 0.97 + meadow_variation * 0.06;\n    }\n    float sunlight = max(dot(normalize(frag_normal), normalize(vec3(-0.5, 0.9, 0.35))), 0.0);\n    vec3 painted = color * (0.42 + gi * 0.58) * (0.92 + sunlight * 0.10) * vec3(1.045, 1.02, 0.92);\n    float fog = smoothstep(28.0, 100.0, distance(frag_position, environment_material_fs_params[2].xyz));\n    g_frag_color = vec4(mix(painted, vec3(0.72, 0.83, 0.80), fog * 0.72), 1.0);\n}\n",
      "inputs": [
        {
          "name": "frag_position",
          "location": 0
        },
        {
          "name": "frag_texturecoord",
          "location": 1
        },
        {
          "name": "frag_normal",
          "location": 2
        },
        {
          "name": "frag_lightmap_uv",
          "location": 3
        }
      ],
      "uniforms": [
        {
          "name": "environment_material_fs_params",
          "size": 64,
          "binding": 0,
          "members": [
            {
              "name": "ball_position",
              "offset": 0,
              "size": 16
            },
            {
              "name": "lightmap_texture_a",
              "offset": 16,
              "size": 4
            },
            {
              "name": "uv_scale",
              "offset": 20,
              "size": 4
            },
            {
              "name": "camera_position",
              "offset": 32,
              "size": 16
            },
            {
              "name": "garden_surface",
              "offset": 48,
              "size": 16
            }
          ]
        }
      ],
      "textures": [
        {
          "name": "environment_material_texture",
          "binding": 0
        },
        {
          "name": "environment_material_lightmap_texture0",
          "binding": 1
        },
        {
          "name": "environment_material_lightmap_texture1",
          "binding": 2
        }
      ]
    }
  },
