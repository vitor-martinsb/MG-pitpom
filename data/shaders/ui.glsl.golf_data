    "fs": {
      "source": "#version 300 es\nprecision highp float;\nprecision highp int;\n\nuniform vec4 ui_fs_params[3];\nuniform sampler2D ui_texture;\n\nin vec2 frag_texture_coord;\n\nout vec4 g_frag_color;\n\nvoid main() {\n    vec2 tc = vec2(ui_fs_params[1].y, ui_fs_params[1].z) + frag_texture_coord * vec2(ui_fs_params[1].w, ui_fs_params[2].x);\n    g_frag_color = texture(ui_texture, tc);\n    // Reinterpret the existing blue nine-slice frames as warm paper and wood.\n    if (ui_fs_params[2].y < 0.5 && g_frag_color.b > 0.25 && g_frag_color.b > g_frag_color.r * 1.4 && g_frag_color.g > g_frag_color.r * 1.25) {\n        float paper = smoothstep(0.28, 0.88, max(g_frag_color.g, g_frag_color.b));\n        g_frag_color.rgb = mix(vec3(0.59, 0.45, 0.30), vec3(0.96, 0.91, 0.81), paper);\n    }\n    g_frag_color.a = ui_fs_params[1].x * (ui_fs_params[2].y*g_frag_color.x + (1.0 - ui_fs_params[2].y)*g_frag_color.a);\n    if (g_frag_color.a < 0.01) discard;\n    g_frag_color.xyz = (1.0 - ui_fs_params[2].y)*((1.0 - ui_fs_params[0].a)*g_frag_color.xyz + ui_fs_params[0].a*ui_fs_params[0].xyz) + ui_fs_params[2].y*ui_fs_params[0].xyz;\n}\n",
      "inputs": [
